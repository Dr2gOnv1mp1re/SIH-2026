# ==============================================================================
# Quantum Risk AI — Backend Production Environment Template
# AI-Powered Continuous Cyber Risk Quantification and Investment Optimization
# Version: SIH 2026 Final | Version 1.0
# ==============================================================================

PROJECT_NAME="Quantum Risk AI — Cyber Risk Quantification & Investment Optimization Platform"
PROJECT_VERSION="SIH 2026 Final | Version 1.0"
ENVIRONMENT="production"
DEBUG=false
API_V1_STR="/api/v1"

# Security & Secrets (Provide your own cryptographic key in .env)
JWT_SECRET="YOUR_CRYPTOGRAPHICALLY_SECURE_256BIT_SECRET_KEY_HERE"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL="sqlite+aiosqlite:///./cyber_risk_enterprise.db"
SYNC_DATABASE_URL="sqlite:///./cyber_risk_enterprise.db"

# Organization defaults
DEFAULT_ORG_NAME="ABC Bank"
DEFAULT_ORG_INDUSTRY="Banking & Financial Services"
DEFAULT_ORG_REVENUE=5000000000.0
DEFAULT_ORG_BUDGET=10000000.0
DEFAULT_ORG_EMPLOYEES=2500

DEFAULT_RISK_APPETITE_MAX_ENTERPRISE=10000000.0
DEFAULT_RISK_APPETITE_CRITICAL_ASSET=1000000.0

# Blockchain Audit
ENABLE_HYPERLEDGER_FABRIC=false
BLOCKCHAIN_NETWORK_NAME="Enterprise-Audit-Fabric-Channel"
FABRIC_MSP_ID="Org1MSP"
FABRIC_PEER_ENDPOINT="grpc://localhost:7051"

# Integrations
WAZUH_API_ENDPOINT="https://wazuh.internal.enterprise.net:55000"
WAZUH_API_USER="YOUR_WAZUH_API_USERNAME"
WAZUH_API_PASSWORD="YOUR_WAZUH_API_PASSWORD"

OPENVAS_ENDPOINT="gmp://openvas.internal.enterprise.net:9390"
OPENVAS_USER="YOUR_OPENVAS_USERNAME"
OPENVAS_PASSWORD="YOUR_OPENVAS_PASSWORD"

NVD_API_KEY=""
CISA_KEV_FEED_URL="https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json"
