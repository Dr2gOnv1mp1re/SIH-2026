# Quantum Risk AI — Environment Configuration Example
# Copy this file to .env and adjust variables as required for your environment.

# ==========================================
# 1. Project & Application Settings
# ==========================================
PROJECT_NAME="Quantum Risk AI — Cyber Risk Quantification & Investment Optimization Platform"
PROJECT_VERSION="2.5.0"
ENVIRONMENT="production"
DEBUG=false
API_V1_STR="/api/v1"

# ==========================================
# 2. Security & JWT Authentication
# ==========================================
# Replace with a cryptographically secure 256-bit random key in production
JWT_SECRET="quantum-risk-ai-production-super-secret-key-2026-sih"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==========================================
# 3. Database Configuration
# ==========================================
# SQLite for lightweight local and offline evaluation
DATABASE_URL="sqlite+aiosqlite:///./cyber_risk_enterprise.db"
SYNC_DATABASE_URL="sqlite:///./cyber_risk_enterprise.db"

# PostgreSQL Configuration (for enterprise cloud deployment):
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/quantum_risk_db"
# SYNC_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/quantum_risk_db"

# ==========================================
# 4. Default Enterprise Profile & Risk Appetite
# ==========================================
DEFAULT_ORG_NAME="ABC Bank"
DEFAULT_ORG_INDUSTRY="Banking & Financial Services"
DEFAULT_ORG_REVENUE=5000000000.0  # ₹500 Crore
DEFAULT_ORG_BUDGET=10000000.0     # ₹1.00 Crore
DEFAULT_ORG_EMPLOYEES=2500

DEFAULT_RISK_APPETITE_MAX_ENTERPRISE=10000000.0  # ₹1.00 Crore
DEFAULT_RISK_APPETITE_CRITICAL_ASSET=1000000.0   # ₹10.0 Lakh

# ==========================================
# 5. Blockchain & Audit Ledger Settings
# ==========================================
ENABLE_HYPERLEDGER_FABRIC=false
BLOCKCHAIN_NETWORK_NAME="Enterprise-Audit-Fabric-Channel"
FABRIC_MSP_ID="Org1MSP"
FABRIC_PEER_ENDPOINT="grpc://localhost:7051"

# ==========================================
# 6. Telemetry & Security Tool Integrations
# ==========================================
WAZUH_API_ENDPOINT="https://wazuh.internal.bank.net:55000"
WAZUH_API_USER="wazuh_agent"
WAZUH_API_PASSWORD="ChangeMeInProduction!"

OPENVAS_ENDPOINT="gmp://openvas.internal.bank.net:9390"
OPENVAS_USER="admin"
OPENVAS_PASSWORD="ChangeMeInProduction!"

NVD_API_KEY=""  # Optional: NVD API Key for higher rate limits
CISA_KEV_FEED_URL="https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json"

# ==========================================
# 7. Frontend Settings
# ==========================================
VITE_API_URL="http://localhost:8000/api/v1"
