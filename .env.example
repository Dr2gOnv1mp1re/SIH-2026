# ==============================================================================
# Quantum Risk AI — Production Environment Template
# AI-Powered Continuous Cyber Risk Quantification and Investment Optimization
# Version: SIH 2026 Final | Version 1.0
# ==============================================================================
# Instructions:
# 1. Copy this file to .env: `cp .env.example .env`
# 2. Populate environment variables with verified production values.
# 3. DO NOT commit the .env file containing live secrets to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & RUNTIME METADATA
# ------------------------------------------------------------------------------
PROJECT_NAME="Quantum Risk AI — Cyber Risk Quantification & Investment Optimization Platform"
PROJECT_VERSION="SIH 2026 Final | Version 1.0"
ENVIRONMENT="production"
DEBUG=false
API_V1_STR="/api/v1"

# ------------------------------------------------------------------------------
# 2. SECURITY & CRYPTOGRAPHY (ZERO SECRETS COMMITTED)
# ------------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET="YOUR_CRYPTOGRAPHICALLY_SECURE_256BIT_SECRET_KEY_HERE"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# 3. DATABASE CONNECTION
# ------------------------------------------------------------------------------
# Standard SQLite Local Evaluator / Production Offline Mode
DATABASE_URL="sqlite+aiosqlite:///./cyber_risk_enterprise.db"
SYNC_DATABASE_URL="sqlite:///./cyber_risk_enterprise.db"

# Enterprise PostgreSQL Alternative:
# DATABASE_URL="postgresql+asyncpg://<db_user>:<db_password>@<db_host>:5432/<db_name>"
# SYNC_DATABASE_URL="postgresql://<db_user>:<db_password>@<db_host>:5432/<db_name>"

# ------------------------------------------------------------------------------
# 4. DEFAULT ENTERPRISE PROFILE & RISK APPETITE
# ------------------------------------------------------------------------------
DEFAULT_ORG_NAME="ABC Bank"
DEFAULT_ORG_INDUSTRY="Banking & Financial Services"
DEFAULT_ORG_REVENUE=5000000000.0  # ₹500 Crore
DEFAULT_ORG_BUDGET=10000000.0     # ₹1.00 Crore
DEFAULT_ORG_EMPLOYEES=2500

DEFAULT_RISK_APPETITE_MAX_ENTERPRISE=10000000.0  # ₹1.00 Crore
DEFAULT_RISK_APPETITE_CRITICAL_ASSET=1000000.0   # ₹10.0 Lakh

# ------------------------------------------------------------------------------
# 5. BLOCKCHAIN AUDIT & INTEGRITY LEDGER
# ------------------------------------------------------------------------------
ENABLE_HYPERLEDGER_FABRIC=false
BLOCKCHAIN_NETWORK_NAME="Enterprise-Audit-Fabric-Channel"
FABRIC_MSP_ID="Org1MSP"
FABRIC_PEER_ENDPOINT="grpc://localhost:7051"

# ------------------------------------------------------------------------------
# 6. EXTERNAL TELEMETRY & THREAT INTELLIGENCE INTEGRATIONS
# ------------------------------------------------------------------------------
WAZUH_API_ENDPOINT="https://wazuh.internal.enterprise.net:55000"
WAZUH_API_USER="YOUR_WAZUH_API_USERNAME"
WAZUH_API_PASSWORD="YOUR_WAZUH_API_PASSWORD"

OPENVAS_ENDPOINT="gmp://openvas.internal.enterprise.net:9390"
OPENVAS_USER="YOUR_OPENVAS_USERNAME"
OPENVAS_PASSWORD="YOUR_OPENVAS_PASSWORD"

NVD_API_KEY=""  # Optional: Obtain from https://nvd.nist.gov/developers/request-an-api-key
CISA_KEV_FEED_URL="https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json"

# ------------------------------------------------------------------------------
# 7. FRONTEND CONNECTIVITY
# ------------------------------------------------------------------------------
VITE_API_URL="http://localhost:8000/api/v1"
